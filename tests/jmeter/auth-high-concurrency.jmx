      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="至少两次有效 429 且 trace_id 不同" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def sensitiveCount = props.get('nginxSensitiveCount').get()
def nonSensitiveCount = props.get('nginxNonSensitiveCount').get()
def rejectedCount = props.get('nginx429Count').get()
def uniqueTraceCount = props.get('nginx429TraceIds').size()
def failures = []
if (sensitiveCount == 0) failures.add('敏感认证接口没有样本')
if (nonSensitiveCount == 0) failures.add('普通路径没有样本')
if (rejectedCount &lt; 2) failures.add('有效 429 少于 2 次')
if (uniqueTraceCount &lt; 2) failures.add('不同 429 的 trace_id 少于 2 个')
def summary = "敏感样本=${sensitiveCount}, 普通样本=${nonSensitiveCount}, 有效429=${rejectedCount}, 不同trace_id=${uniqueTraceCount}"
SampleResult.setResponseData(summary, 'UTF-8')
SampleResult.setSuccessful(failures.isEmpty())
if (!failures.isEmpty()) SampleResult.setResponseMessage(failures.join('；') + '；' + summary)</stringProp>
        </JSR223Sampler>
