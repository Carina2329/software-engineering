          <elementProp name="AUTH_LOOPS" elementType="Argument">
            <stringProp name="Argument.name">AUTH_LOOPS</stringProp>
            <stringProp name="Argument.value">4</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
