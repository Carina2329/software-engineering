        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="断言普通路径不返回认证限流 429" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">props.get('nginxNonSensitiveCount').incrementAndGet()
def status = prev.getResponseCode()
def code = status.isInteger() ? status as int : 0
def passed = code >= 200 &amp;&amp; code &lt; 600 &amp;&amp; code != 429 &amp;&amp; code != 502 &amp;&amp; code != 504
prev.setSuccessful(passed)
if (!passed) {
    prev.setResponseMessage(code == 429 ? '普通路径被认证低额度限流误伤' : '普通路径未得到有效上游响应，HTTP ' + status)
}</stringProp>
