        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="校验敏感接口 429 契约" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

props.get('nginxSensitiveCount').incrementAndGet()
def status = prev.getResponseCode()
if (status == '429') {
    try {
        def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
        def traceId = json.trace_id?.toString()
        def traceHeaderLine = prev.getResponseHeaders().readLines().find {
            it.toLowerCase().startsWith('x-trace-id:')
        }
        def headerTraceId = traceHeaderLine == null ? null : traceHeaderLine.split(':', 2)[1].trim()
        def valid = json.code == 40001 &amp;&amp;
            json.message == '请求过于频繁，请稍后再试' &amp;&amp;
            json.containsKey('data') &amp;&amp; json.data == null &amp;&amp;
            traceId != null &amp;&amp; !traceId.isEmpty() &amp;&amp; traceId != '$request_id' &amp;&amp;
            traceId == headerTraceId &amp;&amp;
            prev.getResponseHeaders().toLowerCase().contains('content-type: application/json; charset=utf-8')
        prev.setSuccessful(valid)
        if (valid) {
            props.get('nginx429Count').incrementAndGet()
            props.get('nginx429TraceIds').add(traceId)
        } else {
            prev.setResponseMessage('429 四字段、Content-Type 或 trace_id/X-Trace-Id 校验失败')
        }
    } catch (Exception error) {
        prev.setSuccessful(false)
        prev.setResponseMessage('429 响应不是有效 JSON: ' + error.getMessage())
    }
} else {
    def code = status.isInteger() ? status as int : 0
    def passed = code >= 200 &amp;&amp; code &lt; 600 &amp;&amp; code != 502 &amp;&amp; code != 504
    prev.setSuccessful(passed)
    if (!passed) {
        prev.setResponseMessage('限额内请求未得到有效上游响应，HTTP ' + status)
    }
}</stringProp>
        </JSR223PostProcessor>
