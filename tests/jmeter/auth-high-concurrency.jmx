        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化线程安全计数器" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.atomic.AtomicInteger

props.put('nginxSensitiveCount', new AtomicInteger(0))
props.put('nginxNonSensitiveCount', new AtomicInteger(0))
props.put('nginx429Count', new AtomicInteger(0))
props.put('nginx429TraceIds', ConcurrentHashMap.newKeySet())</stringProp>
        </JSR223Sampler>
