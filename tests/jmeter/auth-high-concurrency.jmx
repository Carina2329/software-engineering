          <elementProp name="OTHER_LOOPS" elementType="Argument">
            <stringProp name="Argument.name">OTHER_LOOPS</stringProp>
            <stringProp name="Argument.value">15</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.comments">只压测本地 Nginx、后端、Redis、RabbitMQ 和 Mailpit。认证写接口使用空 JSON，不使用真实账号、邮箱、OTP 或 SMTP。</stringProp>
