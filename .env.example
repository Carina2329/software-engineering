# Replace with a random value of at least 32 bytes. Never commit the real value.
AUTH_JWT_SECRET=replace-with-at-least-32-byte-secret
AUTH_JWT_ISSUER=contest-agent-platform
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
MAIL_FROM=no-reply@contest-agent-platform.local

# Authentication email OTP queue. Only this authentication flow may use RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=contest
RABBITMQ_PASSWORD=contest123
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_PREFETCH=3

MAIL_OTP_EXCHANGE=auth.otp.exchange
MAIL_OTP_ROUTING_KEY=auth.otp.send
MAIL_OTP_SEND_QUEUE=auth.otp.send.queue
MAIL_OTP_RETRY_QUEUE=auth.otp.retry.queue
MAIL_OTP_DLQ=auth.otp.dlq
MAIL_OTP_RETRY_DELAY_MS=30000
MAIL_OTP_MAX_RETRIES=3
MAIL_OTP_MESSAGE_TTL_MS=300000

NGINX_HTTP_PORT=8088
